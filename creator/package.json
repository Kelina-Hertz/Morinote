{
  "name": "morinote-ide-offline",
  "version": "0.4.3",
  "private": true,
  "description": "Morinote RenPy IDE with live DSH conversations",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/write-build-version.cjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "package:dir": "npm run build && node scripts/package.cjs",
    "test": "node scripts/test.cjs",
    "test:media-fixture": "electron electron/tests/run-media-fragment-fixture.cjs",
    "test:media-budget-fixture": "electron electron/tests/run-media-fragment-fixture.cjs --low-cost"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.3",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "studio.morinote.ide.offline",
    "productName": "Morinote IDE",
    "directories": {
      "output": "release-0.4.3"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/tests/**/*",
      "README.md",
      "docs/*.md"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!tests/**/*",
          "!**/__pycache__/**/*"
        ]
      },
      {
        "from": "ai-runtime",
        "to": "ai-runtime",
        "filter": [
          "**/*",
          "!node_modules/@deepseek-ai/**/src/**/*",
          "!node_modules/@deepseek-ai/**/lib/types/client/**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "electronDist": "node_modules/electron/dist"
  }
}
